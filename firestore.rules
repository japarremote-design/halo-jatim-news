rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin allowlist - keep this in sync with src/lib/admin.ts
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'japar.remote@gmail.com',
          'storyvideoislami234@gmail.com'
        ];
    }

    // Articles: Anyone can read. Only admin can create/edit/delete content.
    // Exception: any reader (even not logged in) can bump views/likes counters.
    match /articles/{articleId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likes']);
      allow delete: if isAdmin();
    }
    
    // Comments: Anyone can read, logged-in users can post/manage their own
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Bookmarks: Logged-in users can manage their own
    match /bookmarks/{bookmarkId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null;
    }

    // Ads: Anyone can read (so banners render for visitors), only admin can manage
    match /ads/{adId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Pages: Editable footer pages (Tentang, Redaksi, Kontak Kami, Iklan).
    // Anyone can read, only admin can create/edit.
    match /pages/{pageSlug} {
      allow read: if true;
      allow create, update: if isAdmin();
    }
  }
}
