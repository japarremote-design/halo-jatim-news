rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Articles: Anyone can read, logged-in users can write or increment views/likes
    match /articles/{articleId} {
      allow read: if true;
      allow create, update: if true; // Allow initial seeding and view count increments
      allow delete: if request.auth != null;
    }
    
    // Comments: Anyone can read, logged-in users can post/manage
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Bookmarks: Logged-in users can manage their own
    match /bookmarks/{bookmarkId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null;
    }

    // Ads: Anyone can read (so banners render for visitors), only logged-in users can manage
    match /ads/{adId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
  }
}
